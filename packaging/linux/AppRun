#!/bin/sh
set -eu

APPDIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
export APPDIR
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export GTK_EXE_PREFIX="$APPDIR/usr"
export GTK_DATA_PREFIX="$APPDIR/usr"

if [ -d "$APPDIR/usr/share/glib-2.0/schemas" ]; then
    export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"
fi
if [ -d "$APPDIR/usr/lib/gtk-4.0" ]; then
    export GTK_PATH="$APPDIR/usr/lib/gtk-4.0"
fi
for cache in "$APPDIR"/usr/lib/gdk-pixbuf-2.0/*/loaders.cache; do
    if [ -f "$cache" ]; then
        export GDK_PIXBUF_MODULE_FILE="$cache"
        break
    fi
done

if [ "${1:-}" = "--cli" ]; then
    shift
    exec "$APPDIR/usr/bin/wavelite" "$@"
fi
exec "$APPDIR/usr/bin/wavelite-gui" "$@"
